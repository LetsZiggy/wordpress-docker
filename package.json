{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "docker",
	"version": "0.0.0",
	"type": "module",
	"description": "docker",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"fix:eslint": "pnpm exec eslint --config ./eslint.config.js --max-warnings 0 --no-warn-ignored --fix",
		"fix:prettier": "pnpm exec prettier --config ./prettier.config.js --write"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/node": "^26.2.0",
		"eslint": "^10.9.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^18.3.0",
		"eslint-plugin-promise": "^7.3.0",
		"eslint-plugin-regexp": "^3.2.0",
		"eslint-plugin-sort-class-members": "^1.22.1",
		"eslint-plugin-sort-destructure-keys": "^3.0.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-attributes": "^1.0.0",
		"prettier-plugin-pkg": "^0.22.1",
		"prettier-plugin-tsconfig": "github:LetsZiggy/prettier-plugin-tsconfig",
		"tslib": "^2.8.1",
		"type-fest": "^5.8.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0"
	}
}
